    - target: {fileID: 8441010988262084743, guid: 3d3247895cca89e4aa2f689d0e05f18b, type: 3}
      propertyPath: firstLine
      value: 'Ever since the crystals went haywire, the village has been living in
        darkness. My late husband used to say that a crystal is like a goat: if you
        give it too much, it gets sulky.'
      objectReference: {fileID: 0}
    - target: {fileID: 8441010988262084743, guid: 3d3247895cca89e4aa2f689d0e05f18b, type: 3}
      propertyPath: secondLine
      value: "He would spend hours turning them over, one by one. Whenever one of
        them went out, he would grumble, \u201CWho\u2019s bothering you again?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8441010988262084743, guid: 3d3247895cca89e4aa2f689d0e05f18b, type: 3}
      propertyPath: solvedLine
      value: The lights are coming back on! My husband would have been proud of you.
      objectReference: {fileID: 0}
    - target: {fileID: 8441010988262084743, guid: 3d3247895cca89e4aa2f689d0e05f18b, type: 3}
      propertyPath: planetCenter
      value: 
      objectReference: {fileID: 1252233775}
    - target: {fileID: 8441010988262084743, guid: 3d3247895cca89e4aa2f689d0e05f18b, type: 3}
      propertyPath: charsPerSecond
      value: 28
      objectReference: {fileID: 0}
